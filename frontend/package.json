{
  "name": "riskhub-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc -b && vite build && npm run quality:login-graph",
    "lint": "eslint . && npm run lint:a11y && npm run lint:dialog-inventory",
    "lint:a11y": "node scripts/a11y/jsx-a11y-baseline.mjs",
    "lint:dialog-inventory": "node scripts/a11y/validate-dialog-inventory.mjs",
    "e2e:a11y:collect": "node scripts/a11y/validate-playwright-a11y-collection.mjs",
    "e2e:a11y:results": "node scripts/a11y/validate-playwright-a11y-results.mjs",
    "e2e:dora:collect": "node scripts/quality/validate-dora-e2e-coverage.mjs",
    "quality:debt": "node scripts/quality/debt-budget.mjs",
    "quality:login-graph": "node scripts/quality/validate-login-dependency-graph.mjs",
    "quality:ui-ratchet": "node scripts/quality/ui-consistency-ratchet.mjs",
    "i18n:inventory": "node scripts/i18n/inventory-ui-text.mjs",
    "i18n:scan": "node scripts/i18n/scan-hardcoded-ui.mjs",
    "i18n:validate:strict": "node scripts/i18n/validate-parity.mjs",
    "i18n:validate:usage": "node scripts/i18n/validate-key-usage.mjs",
    "i18n:validate:plurals": "node scripts/i18n/validate-plurals.mjs",
    "cleanup:deadcode": "node scripts/cleanup/find-unreachable-modules.mjs",
    "i18n:test": "npm run i18n:validate:strict && npm run i18n:validate:usage && npm run i18n:validate:plurals && npm run i18n:scan && npm run cleanup:deadcode && npm run test:run -- src/i18n",
    "preview": "vite preview",
    "test": "vitest -c vitest.config.ts",
    "test:run": "vitest run -c vitest.config.ts",
    "test:coverage": "vitest run -c vitest.config.ts --coverage",
    "test:e2e": "playwright test -c playwright.config.ts",
    "e2e": "playwright test -c playwright.config.ts",
    "e2e:ui": "playwright test -c playwright.config.ts --ui",
    "e2e:headed": "playwright test -c playwright.config.ts --headed",
    "e2e:report": "playwright show-report ../tests/results/frontend/playwright/playwright-report",
    "e2e:business-logic": "playwright test -c playwright.config.ts ../tests/frontend/e2e/roles-access.spec.ts ../tests/frontend/e2e/access-scope.spec.ts ../tests/frontend/e2e/entity-ownership ../tests/frontend/e2e/department-access.spec.ts ../tests/frontend/e2e/permissions ../tests/frontend/e2e/approval-workflows ../tests/frontend/e2e/sensitive-fields ../tests/frontend/e2e/cross-department ../tests/frontend/e2e/activity-logging"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@tanstack/react-query": "^5.102.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.5.2",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.11"
  }
}
