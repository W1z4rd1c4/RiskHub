# Intended native production profile; release admission remains closed until #208.
# Non-secret configuration only. Use --mfa-policy optional to allow password-only accounts.
PUBLIC_URL=https://riskhub.example.com
AUTH_MODE=password
DIRECTORY_PROVIDER=none
LOCAL_MFA_POLICY=required
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_CRO_EMAIL=cro@example.com
LOCAL_SMTP_HOST=smtp.example.com
LOCAL_SMTP_PORT=587
LOCAL_SMTP_SECURITY=starttls
LOCAL_SMTP_SENDER=riskhub@example.com
LOCAL_SMTP_USERNAME=riskhub
LOCAL_KDF_MEMORY_BUDGET_MIB=1024
# Optional additional blocked passwords and private SMTP CA, stored under the secret directory.
# LOCAL_PASSWORD_BLOCKLIST_FILE=/etc/riskhub/secrets/local_password_blocklist
# LOCAL_SMTP_CA_FILE=/etc/riskhub/secrets/local_smtp_ca
API_WORKERS=4
FRONTEND_BIND_PORT=80
METRICS_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=riskhub-api
