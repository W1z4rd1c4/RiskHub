{
  "schema_version": 1,
  "required_on_protected_main": [
    "Backend Quality",
    "Docker Onboarding Smoke",
    "Frontend + Repo Contracts",
    "PR Merge Result Build",
    "Playwright E2E Tests",
    "Public Repo Hygiene"
  ],
  "checks": [
    {
      "job_name": "Frontend Unit Tests",
      "workflow": ".github/workflows/lint.yml",
      "job_id": "frontend-unit-tests",
      "triggers": ["pull_request", "push"],
      "owner": "Frontend",
      "runtime_budget": "3-10 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Backend Quality",
      "workflow": ".github/workflows/lint.yml",
      "job_id": "backend-quality",
      "triggers": ["pull_request", "push"],
      "owner": "Backend",
      "runtime_budget": "2-8 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "Frontend + Repo Contracts",
      "workflow": ".github/workflows/lint.yml",
      "job_id": "lint",
      "triggers": ["pull_request", "push"],
      "owner": "Repository",
      "runtime_budget": "6-15 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "PR Merge Result Build",
      "workflow": ".github/workflows/lint.yml",
      "job_id": "pr-merge-result-build",
      "triggers": ["pull_request", "push"],
      "job_if_contains": "github.event_name == 'pull_request'",
      "owner": "Frontend/Release",
      "runtime_budget": "2-6 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "Backend SQLite Regression",
      "workflow": ".github/workflows/backend-postgres.yml",
      "job_id": "sqlite-tests",
      "triggers": ["pull_request", "push"],
      "owner": "Backend",
      "runtime_budget": "8-20 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Backend Postgres Regression",
      "workflow": ".github/workflows/backend-postgres.yml",
      "job_id": "postgres-tests",
      "triggers": ["pull_request", "push"],
      "owner": "Backend/Data",
      "runtime_budget": "20-35 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Playwright E2E Tests",
      "workflow": ".github/workflows/e2e.yml",
      "job_id": "e2e-tests",
      "triggers": ["pull_request", "push", "workflow_dispatch"],
      "owner": "Product/QA",
      "runtime_budget": "2-15 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "Production Profile Smoke",
      "workflow": ".github/workflows/e2e.yml",
      "job_id": "production-profile-smoke",
      "triggers": ["pull_request", "push", "workflow_dispatch"],
      "owner": "Backend/Security",
      "runtime_budget": "5-20 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Docker Onboarding Smoke",
      "workflow": ".github/workflows/startup-smoke.yml",
      "job_id": "docker-onboarding-smoke",
      "triggers": ["pull_request", "push", "schedule", "workflow_dispatch"],
      "owner": "Deployment/Operations",
      "runtime_budget": "8-20 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "Public Repo Hygiene",
      "workflow": ".github/workflows/security.yml",
      "job_id": "public-repo-hygiene",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Security/Repository",
      "runtime_budget": "1-5 min",
      "required_on_protected_main": true
    },
    {
      "job_name": "Workflow Pin Validation",
      "workflow": ".github/workflows/security.yml",
      "job_id": "workflow-pin-validation",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Security/Repository",
      "runtime_budget": "1-5 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Authorization Capability Contract",
      "workflow": ".github/workflows/security.yml",
      "job_id": "authz-capability-contract",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Security/Authorization",
      "runtime_budget": "1-5 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Python Security (Bandit + pip-audit)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "python-security",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Backend/Security",
      "runtime_budget": "3-12 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Frontend Security (npm audit)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "frontend-security",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Frontend/Security",
      "runtime_budget": "2-8 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Frontend i18n (Parity + Hardcoded Scan)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "frontend-i18n",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Frontend",
      "runtime_budget": "2-8 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Redis Resilience Integration (non-blocking)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "redis-resilience-integration",
      "triggers": ["pull_request", "push", "schedule"],
      "job_if_contains": "github.event_name == 'schedule'",
      "continue_on_error": true,
      "owner": "Backend/Security",
      "runtime_budget": "2-10 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Container Scan (Trivy + SBOM Correlation)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "container-security",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Security/Supply Chain",
      "runtime_budget": "8-25 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Secrets Detection (Gitleaks)",
      "workflow": ".github/workflows/security.yml",
      "job_id": "secrets-detection",
      "triggers": ["pull_request", "push", "schedule"],
      "owner": "Security",
      "runtime_budget": "1-5 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Security Headers Verification",
      "workflow": ".github/workflows/security.yml",
      "job_id": "security-headers",
      "triggers": ["pull_request", "push", "schedule"],
      "job_if_contains": "github.event_name == 'pull_request'",
      "owner": "Backend/Security",
      "runtime_budget": "2-8 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Docs Governance",
      "workflow": ".github/workflows/maintenance-governance.yml",
      "job_id": "docs-governance",
      "triggers": ["pull_request", "schedule", "workflow_dispatch"],
      "pull_request_path_filtered": true,
      "owner": "Maintainer/Docs",
      "runtime_budget": "2-10 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Frontend Maintenance Contracts",
      "workflow": ".github/workflows/maintenance-governance.yml",
      "job_id": "frontend-maintenance",
      "triggers": ["pull_request", "schedule", "workflow_dispatch"],
      "pull_request_path_filtered": true,
      "owner": "Frontend/Maintainer",
      "runtime_budget": "5-20 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Backend Maintenance (Informational)",
      "workflow": ".github/workflows/maintenance-governance.yml",
      "job_id": "backend-maintenance-informational",
      "triggers": ["pull_request", "schedule", "workflow_dispatch"],
      "pull_request_path_filtered": true,
      "continue_on_error": true,
      "owner": "Backend/Maintainer",
      "runtime_budget": "5-20 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Release Parity Contract",
      "workflow": ".github/workflows/release-parity-pr.yml",
      "job_id": "parity-contract",
      "triggers": ["workflow_dispatch"],
      "owner": "Release",
      "runtime_budget": "2-8 min",
      "required_on_protected_main": false
    },
    {
      "job_name": "Fast Parity Audit (Non-Blocking)",
      "workflow": ".github/workflows/release-parity-fast.yml",
      "job_id": "parity-fast",
      "triggers": ["push", "schedule", "workflow_dispatch"],
      "continue_on_error": true,
      "owner": "Release",
      "runtime_budget": "20-60 min",
      "required_on_protected_main": false
    }
  ]
}
